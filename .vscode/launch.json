{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bot (poller + telegram)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "preLaunchTask": "Stop bot + pulizia RAM"
    },
    {
      "name": "Bot (solo poller, senza telegram)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/main.py",
      "args": ["--nobot"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "preLaunchTask": "Stop bot + pulizia RAM"
    },
    {
      "name": "Test e2e (ricerca disponibilità)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/study/test_e2e.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "preLaunchTask": "Stop bot + pulizia RAM"
    },
    {
      "name": "Test spostamento (reschedule)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/study/test_resched.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "preLaunchTask": "Stop bot + pulizia RAM"
    }
  ]
}