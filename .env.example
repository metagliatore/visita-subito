# ============================================================
# Esempio: copiare in .env e compilare.
# .env non è versionato (vedi .gitignore).
# ============================================================

# --- Telegram ---
TG_TOKEN=
TG_CHAT_ID=
TG_CHAT_ID_SECONDARY=

# --- Autenticazione (SPID / CIE / Manuale) ---
# Metodo: spid | cie | manual
AUTH_METHOD=spid

# Provider SPID: sielte, poste, aruba, infocert, lepida, namirial, tim...
SPID_PROVIDER=sielte
SPID_USERNAME=
SPID_PASSWORD=
SPID_OTP_MODE=notifica   # notifica (push app) oppure otp (SMS)

# Retrocompatibilità SielteID
SIELTE_USERNAME=
SIELTE_PASSWORD=

# Modalità CIE (CieID / Smartcard)
CIE_MODE=app             # app oppure smartcard
CIE_USERNAME=
CIE_PASSWORD=


# --- Browser ---
CHROME_BIN=

POLL_INTERVAL_SECONDS=300
MAX_LOGIN_RETRIES=3

# --- Timeout attesa decisione proposta su Telegram (sec) ---
APPROVAL_TIMEOUT_SECONDS=600
