# ============================================================
# Esempio: copiare in .env e compilare.
# .env non è versionato (vedi .gitignore).
# ============================================================

# --- Telegram ---
TG_TOKEN=
TG_CHAT_ID=
TG_CHAT_ID_SECONDARY=

# --- IdP SielteID (login SPID) ---
SIELTE_USERNAME=
SIELTE_PASSWORD=
SIELTE_OTP_MODE=notifica   # notifica (push app) oppure otp (SMS)

# --- Browser ---
CHROME_BIN=

# --- Scheduler ---
POLL_INTERVAL_SECONDS=300MAX_LOGIN_RETRIES=3
