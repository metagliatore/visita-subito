# ============================================================
# Esempio: copiare in .env e compilare.
# .env non è versionato (vedi .gitignore).
# ============================================================

# --- Modalità di controllo (telegram | cli) ---
CONTROL_INTERFACE=telegram
SOUND_ALERT=true

# --- Telegram (se CONTROL_INTERFACE=telegram) ---
TG_TOKEN=
TG_CHAT_ID=
TG_CHAT_ID_SECONDARY=

# --- Autenticazione (spid | cie | manual) ---
AUTH_METHOD=spid

# --- Autenticazione SPID (se AUTH_METHOD=spid) ---
# Provider supportati: sielte, poste, aruba, infocert, lepida, namirial, tim...
SPID_PROVIDER=sielte
SPID_USERNAME=
SPID_PASSWORD=
SPID_OTP_MODE=notifica   # notifica/app (push app), otp/sms (SMS) oppure qr (QR Code)

# Opzionale: configurazione dedicata SPID PosteID (Poste Italiane) [SPERIMENTALE]
# NOTA: L'accesso tramite PosteID è attualmente in fase sperimentale.
# POSTE_USERNAME=
# POSTE_PASSWORD=
# POSTE_MODE=app         # "app" (notifica push), "sms" (codice SMS OTP) o "qr" (QR Code)

# Retrocompatibilità SielteID
SIELTE_USERNAME=
SIELTE_PASSWORD=
SIELTE_OTP_MODE=notifica

# --- Autenticazione CIE (se AUTH_METHOD=cie) ---
# Modalità: "app" (Livello 2 credenziali / fallback QR), "qr" (QR Code diretto via Telegram) o "smartcard" (Livello 3 NFC)
CIE_MODE=app
# Credenziali Livello 2: Codice Fiscale o Numero CIE (es. CA00000AA) e password
CIE_USERNAME=
CIE_PASSWORD=

# --- Browser & Scheduler ---
CHROME_BIN=
POLL_INTERVAL_SECONDS=300
MAX_LOGIN_RETRIES=3

# --- Timeout attesa decisione proposta su Telegram (sec) ---
APPROVAL_TIMEOUT_SECONDS=600

# --- Timeout attesa caricamento lista appuntamenti riprogrammazione (sec, default 30) ---
RESCHEDULE_WAIT_TIMEOUT=30

# --- Limite minimo giorni lavorativi per anticipo (evita penale malus ticket SSN/Regione) ---
# In Regione Lombardia e nel SSN la disdetta o lo spostamento di un appuntamento deve pervenire con
# almeno 3 giorni lavorativi di anticipo, altrimenti scatta il pagamento del "malus ticket" (l'intera tariffa).
# Se mancano meno di X giorni lavorativi alla data della visita già prenotata, il monitor viene fermato
# automaticamente con allarme sonoro e notifica per proteggere l'utente da addebiti economici sanzionatori.
# Il conteggio esclude sabati, domeniche e tutte le festività nazionali italiane (inclusa la Pasquetta).
# Default: 3 giorni lavorativi. Imposta a 0 per disattivare il controllo preventivo.
RESCHEDULE_MIN_WORKING_DAYS=3

# --- Fast-Track Auto-Booking ("Sniper mode" istantaneo) ---
# Se abilitato (true), prenota immediatamente la prima disponibilità conforme senza attendere
# la conferma manuale dell'utente (tap su Telegram / console). Ideale per gli slot ad altissima
# richiesta che spariscono in pochissimi secondi.
# Default: false (disattivato per massima cautela).
AUTO_BOOK=false

# Giorni minimi di anticipo rispetto ad oggi per consentire la prenotazione automatica.
# Questo numero serve a tutelarsi da possibili appuntamenti scomodi che poi non possono essere
# più spostati in avanti o disdetti/annullati senza pagare una sanzione economica (regola dei 3 giorni
# lavorativi di preavviso per evitare il malus ticket del Servizio Sanitario).
# Se viene trovato uno slot valido con meno di X giorni di anticipo, il bot NON lo prenota in automatico,
# ma invia la consueta richiesta di approvazione manuale su Telegram.
# Default: 5 giorni.
AUTO_BOOK_MIN_DAYS=5

# --- Strategia ricerca multi-provincia (first_match [consigliata] | best_match) ---
SEARCH_STRATEGY=first_match

# --- Calcolo Distanza & Tempi di Percorso da Casa (Auto e Trasporto Pubblico) ---
# Se configurate, il bot calcola la distanza stradale e i tempi stimati di spostamento
# verso l'ospedale/struttura sia in auto (nelle ore di punta) che con il trasporto pubblico
# (metropolitana, passante/treno, autobus o a piedi).
# Per recuperare le coordinate: apri Google Maps nel browser, fai tasto destro sulla tua casa
# e clicca sulle prime cifre in cima (es. "45.4642, 9.1900") per copiarle negli appunti.
# Se lasciate vuote, il calcolo della distanza NON viene eseguito e le notifiche restano standard.
# Formati supportati: "lat, lon" (es. 45.4642, 9.1900) oppure variabili separate HOME_LATITUDE e HOME_LONGITUDE.
HOME_COORDINATES=
# HOME_LATITUDE=
# HOME_LONGITUDE=

# --- Debug & Dump (screenshot ed HTML in caso di errore) ---
DEBUG_DUMP_DIR=data/debug

# --- Benvenuto e Aggiornamenti GitHub ---
# Controlla la presenza di nuove release su GitHub all'avvio dell'applicativo (true | false)
CHECK_UPDATES=true

# Invia messaggio di benvenuto con stato versione su Telegram all'avvio (true | false)
TG_STARTUP_NOTIFICATION=true

# --- Supporto e Donazioni (opzionale) ---
# Se valorizzato, invia un messaggio di ringraziamento con pulsanti per offrire un caffè dopo ogni prenotazione effettuata con successo.
# Se lasciato vuoto, nessun messaggio di donazione viene inviato.
# Servizi supportati: Buy Me a Coffee, PayPal.me, Ko-fi o qualsiasi URL personalizzato.
DONATION_URL=
# DONATION_ENABLED=true
# DONATION_URL_2EUR=
# DONATION_URL_3EUR=
# DONATION_URL_5EUR=

